@@ -0,0 +1,69 @@
+import { ConflictException, Injectable, Logger, NotFoundException } from '@nestjs/common';
+import type { RequestUser } from '../../common/types/request-user';
+import { resolveTimeZone, toDateKeyInTimeZone } from '../../common/utils/timezone.utils';
+import { sanitizeLogValue } from '../../common/utils/log-sanitize.utils';
+import { ReadingOpeningService } from '../user-book-status/reading-opening.service';
+import { HardcoverOpeningService } from '../hardcover/hardcover-opening.service';
+import { HardcoverSyncService } from '../hardcover/hardcover-sync.service';
+import { KoreaderRepository } from './koreader.repository';
+import { KoreaderOpeningDto } from './dto/koreader-opening.dto';
+
+@Injectable()
+export class KoreaderOpeningService {
+  private readonly logger = new Logger(KoreaderOpeningService.name);
+  constructor(
+    private readonly repo: KoreaderRepository,
+    private readonly openings: ReadingOpeningService,
+    private readonly hardcover: HardcoverOpeningService,
+    private readonly sync: HardcoverSyncService,
+  ) {}
+
+  async start(user: RequestUser, dto: KoreaderOpeningDto) {
+    const libraries = await this.repo.getAccessibleLibraryIds(user.id);
+    const file = await this.repo.resolveBookFileByHash(dto.document, libraries, user.id);
+    if (!file) throw new NotFoundException('Book not found');
+    const today = toDateKeyInTimeZone(new Date(), resolveTimeZone((user.settings as { timezone?: unknown })?.timezone, 'UTC'));
+    return this.sync.withBookSyncLock(user.id, file.bookId, async () => {
+      const row = await this.openings.start(user.id, file.bookId, file.id, dto.deviceId, dto.id, today);
+      const hardcoverPending = await this.remoteStep('start', row, () => this.hardcover.start(row, today));
+      return { id: row.id, phase: row.phase, hardcoverPending };
+    });
+  }
+
+  async finish(user: RequestUser, dto: KoreaderOpeningDto, undo: boolean) {
+    const row = await this.openings.find(user.id, dto.id);
+    const libraries = await this.repo.getAccessibleLibraryIds(user.id);
+    const file = await this.repo.resolveBookFileByHash(dto.document, libraries, user.id);
+    if (!file || file.id !== row.bookFileId || file.bookId !== row.bookId || row.deviceId !== dto.deviceId)
+      throw new NotFoundException('Opening not found');
+    return this.hardcover.withLock(row, async () => {
+      const current = await this.openings.find(user.id, row.id);
+      if (!undo) {
+        if (current.phase === 'undone') throw new ConflictException('This opening has already been undone');
+        await this.openings.commit(current);
+        return { id: row.id, phase: 'committed', hardcoverPending: false };
+      }
+      await this.openings.restore(current);
+      const hardcoverPending = await this.remoteStep('undo', current, () => this.hardcover.undo(current));
+      return { id: row.id, phase: 'undone', hardcoverPending };
+    });
+  }
+
+  private async remoteStep(action: string, row: Awaited<ReturnType<ReadingOpeningService['find']>>, run: () => Promise<void>): Promise<boolean> {
+    const start = Date.now();
+    this.logger.log(`[reading.opening] [start] userId=${row.userId} bookId=${row.bookId} action=${action} - Hardcover opening operation started`);
+    try {
+      await run();
+      this.logger.log(
+        `[reading.opening] [end] userId=${row.userId} bookId=${row.bookId} action=${action} durationMs=${Date.now() - start} - Hardcover opening operation completed`,
+      );
+      return false;
+    } catch (error) {
+      const message = sanitizeLogValue(error instanceof Error ? error.message : String(error));
+      this.logger.warn(
+        `[reading.opening] [fail] userId=${row.userId} bookId=${row.bookId} action=${action} durationMs=${Date.now() - start} errorClass=${error instanceof Error ? error.constructor.name : 'Unknown'} error="${message}" - retained for explicit retry`,
+      );
+      return true;
+    }
+  }
+}
