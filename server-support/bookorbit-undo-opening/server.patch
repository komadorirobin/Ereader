+  ])('respects Hardcover enablement, triggers and scope', async (flags) => {
+    settings.getSettings.mockResolvedValue(flags);
+    await service.start(row, '2026-10-01');
+    expect(client.query).not.toHaveBeenCalled();
+  });
+
+  it('does not create a read if another reader started during preparation', async () => {
+    client.query.mockResolvedValueOnce(remote()).mockResolvedValueOnce(remote([read], 2));
+    await expect(service.start(row, '2026-10-01')).rejects.toThrow('changed while preparing');
+    expect(client.query.mock.calls.some((call) => call[2].includes('mutation'))).toBe(false);
+  });
+
+  it('removes only the owned unchanged read and restores only the old status', async () => {
+    active();
+    client.query
+      .mockResolvedValueOnce(remote([read], 2))
+      .mockResolvedValueOnce({ user_book_reads: [read] })
+      .mockResolvedValueOnce({ delete_user_book_read: { id: 901 } })
+      .mockResolvedValueOnce({ user_book_reads: [] })
+      .mockResolvedValueOnce(remote([], 2))
+      .mockResolvedValueOnce({ update_user_book: { error: null } });
+    await service.undo(row);
+    expect(client.query.mock.calls[2]![3]).toEqual({ id: 901 });
+    expect(client.query.mock.calls[5]![3]).toEqual({ id: 55, object: { status_id: 1 } });
+    expect(row.hardcover.phase).toBe('restored');
+    expect(repo.upsertBookState).toHaveBeenCalledWith(expect.objectContaining({ userId: 1, bookId: 2, hardcoverReadId: 77 }));
+    await service.undo(row);
+    expect(client.query).toHaveBeenCalledTimes(6);
+  });
+
+  it.each([
+    { progress_pages: 1 },
+    { progress_seconds: 60 },
+    { progress: 0.5 },
+    { paused_at: '2026-10-02' },
+    { started_at: '2026-09-01' },
+    { finished_at: '2026-10-02' },
+    { finished_at_precision: 1 },
+    { edition_id: 21 },
+    { user_book_id: 56 },
+  ])('refuses to delete an edited or progressed read: %j', async (change) => {
+    active();
+    client.query.mockResolvedValueOnce(remote([read], 2)).mockResolvedValueOnce({ user_book_reads: [{ ...read, ...change }] });
+    await expect(service.undo(row)).rejects.toThrow('progressed');
+    expect(client.query.mock.calls.some((call) => call[2].includes('mutation'))).toBe(false);
+  });
+
+  it('protects a different active read even when ours is unchanged', async () => {
+    active();
+    client.query.mockResolvedValueOnce(remote([read, { ...read, id: 999 }], 2));
+    await expect(service.undo(row)).rejects.toThrow('Another Hardcover reading');
+    expect(client.query).toHaveBeenCalledTimes(1);
+  });
+
+  it('can resume after the delete succeeded but its response was lost', async () => {
+    active();
+    client.query
+      .mockResolvedValueOnce(remote([read], 2))
+      .mockResolvedValueOnce({ user_book_reads: [read] })
+      .mockRejectedValueOnce(new Error('lost reply'));
+    await expect(service.undo(row)).rejects.toThrow('lost reply');
+    expect(row.hardcover.phase).toBe('deleting');
+    client.query
+      .mockResolvedValueOnce(remote([], 2))
+      .mockResolvedValueOnce({ user_book_reads: [] })
+      .mockResolvedValueOnce(remote([], 2))
+      .mockResolvedValueOnce({ update_user_book: { error: null } });
+    await service.undo(row);
+    expect(row.hardcover.phase).toBe('restored');
+    expect(client.query.mock.calls.filter((call) => call[2].includes('delete_user_book_read'))).toHaveLength(1);
+  });
+
+  it('does not report successful deletion when Hardcover still returns the read', async () => {
+    active();
+    client.query
+      .mockResolvedValueOnce(remote([read], 2))
+      .mockResolvedValueOnce({ user_book_reads: [read] })
+      .mockResolvedValueOnce({ delete_user_book_read: { error: 'denied' } })
+      .mockResolvedValueOnce({ user_book_reads: [read] });
+    await expect(service.undo(row)).rejects.toThrow('did not confirm deletion');
+    expect(row.hardcover.phase).toBe('deleting');
+  });
+
+  it('does not restore status after a new read appears between deletion and restoration', async () => {
+    active();
+    row.hardcover.phase = 'deleted';
+    client.query.mockResolvedValueOnce(remote([], 2)).mockResolvedValueOnce(remote([{ ...read, id: 999 }], 2));
+    await expect(service.undo(row)).rejects.toThrow('changed before');
+    expect(client.query.mock.calls.some((call) => call[2].includes('mutation'))).toBe(false);
+  });
+
+  it('requires a known full read snapshot', () => {
+    expect(openingReadUnchanged(undefined, read)).toBe(false);
+    expect(openingReadUnchanged({ ...read }, read)).toBe(true);
+    expect(openingReadUnchanged({ ...read, progress_pages: 4 }, read)).toBe(false);
+  });
+});
diff --git a/server/src/modules/hardcover/hardcover-opening.service.ts b/server/src/modules/hardcover/hardcover-opening.service.ts
