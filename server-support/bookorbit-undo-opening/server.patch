+import { Body, Controller, Post, UseGuards } from '@nestjs/common';
+import { Permission } from '@bookorbit/types';
+import { CurrentUser } from '../../common/decorators/current-user.decorator';
+import { Public } from '../../common/decorators/public.decorator';
+import { RequirePermission } from '../../common/decorators/require-permission.decorator';
+import type { RequestUser } from '../../common/types/request-user';
+import { KoreaderAuthGuard } from './koreader-auth.guard';
+import { KoreaderOpeningDto } from './dto/koreader-opening.dto';
+import { KoreaderOpeningService } from './koreader-opening.service';
+
+@Public()
+@UseGuards(KoreaderAuthGuard)
+@Controller('koreader/plugin/openings')
+export class KoreaderOpeningController {
+  constructor(private readonly openings: KoreaderOpeningService) {}
+
+  @RequirePermission(Permission.KoreaderSync)
+  @Post()
+  start(@CurrentUser() user: RequestUser, @Body() dto: KoreaderOpeningDto) {
+    return this.openings.start(user, dto);
+  }
+
+  @RequirePermission(Permission.KoreaderSync)
+  @Post('commit')
+  commit(@CurrentUser() user: RequestUser, @Body() dto: KoreaderOpeningDto) {
+    return this.openings.finish(user, dto, false);
+  }
+
+  @RequirePermission(Permission.KoreaderSync)
+  @Post('undo')
+  undo(@CurrentUser() user: RequestUser, @Body() dto: KoreaderOpeningDto) {
+    return this.openings.finish(user, dto, true);
+  }
+}
