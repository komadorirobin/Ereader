+    expect(repo.linkReadingAttempt).toHaveBeenCalledWith(1, 4, 901);
+    const calls = client.query.mock.calls;
+    expect(calls[2]![2]).toContain('insert_user_book_read');
+    expect(calls[4]![3]).toEqual({ id: 55, object: { status_id: 2 } });
+    await service.start(row, '2026-10-01');
+    expect(client.query).toHaveBeenCalledTimes(5);
+  });
+
+  it('never guesses a reading ID or inserts again after an ambiguous creation', async () => {
+    client.query.mockResolvedValueOnce(remote()).mockResolvedValueOnce(remote()).mockRejectedValueOnce(new Error('timeout'));
+    await expect(service.start(row, '2026-10-01')).rejects.toThrow('timeout');
+    expect(row.hardcover.phase).toBe('creating');
+    await expect(service.start(row, '2026-10-01')).rejects.toThrow('did not confirm');
+    await expect(service.undo(row)).rejects.toThrow('ownership is uncertain');
+    expect(client.query).toHaveBeenCalledTimes(3);
+  });
+
+  it('does not set reading status if the owned read disappeared during creation', async () => {
+    client.query
+      .mockResolvedValueOnce(remote())
+      .mockResolvedValueOnce(remote())
+      .mockResolvedValueOnce({ insert_user_book_read: { error: null, user_book_read: read } })
