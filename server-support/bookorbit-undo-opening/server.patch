index 0000000..98e7a0a
--- /dev/null
+++ b/server/src/modules/hardcover/hardcover-opening.service.ts
@@ -0,0 +1,205 @@
+import { ConflictException, Injectable, ServiceUnavailableException } from '@nestjs/common';
+import { ReadingOpeningService } from '../user-book-status/reading-opening.service';
+import { HardcoverRepository } from './hardcover.repository';
+import { HardcoverClientService } from './hardcover-client.service';
+import { HardcoverSettingsService } from './hardcover-settings.service';
+import { HardcoverBookMatchService } from './hardcover-book-match.service';
+import { HardcoverSyncService } from './hardcover-sync.service';
+
+type Opening = Awaited<ReturnType<ReadingOpeningService['find']>>;
+type RemoteRead = {
+  id: number;
+  user_book_id: number;
+  started_at: string | null;
+  finished_at: string | null;
+  finished_at_precision: number | null;
+  paused_at: string | null;
+  progress: number | null;
+  progress_pages: number | null;
+  progress_seconds: number | null;
+  edition_id: number | null;
+};
+type RemoteBook = { id: number; status_id: number; user_book_reads: RemoteRead[] };
+const READ_FIELDS = 'id user_book_id started_at finished_at finished_at_precision paused_at progress progress_pages progress_seconds edition_id';
+const QUERY = `query OpeningBook($bookId: Int!) {
+  me { user_books(where: {book_id: {_eq: $bookId}}, limit: 1) {
+    id status_id user_book_reads(where: {finished_at: {_is_null: true}}, limit: 100) { ${READ_FIELDS} }
+  } }
+}`;
+const READ_QUERY = `query OpeningRead($id: Int!) { user_book_reads(where: {id: {_eq: $id}}, limit: 1) { ${READ_FIELDS} } }`;
+
+export function openingReadUnchanged(expected: Record<string, unknown> | undefined, actual: RemoteRead): boolean {
+  return !!expected && READ_FIELDS.split(' ').every((key) => (expected[key] ?? null) === (actual[key as keyof RemoteRead] ?? null));
+}
+
+@Injectable()
+export class HardcoverOpeningService {
+  constructor(
+    private readonly openings: ReadingOpeningService,
+    private readonly repo: HardcoverRepository,
+    private readonly client: HardcoverClientService,
+    private readonly settings: HardcoverSettingsService,
+    private readonly match: HardcoverBookMatchService,
+    private readonly sync: HardcoverSyncService,
+  ) {}
+
+  withLock<T>(row: Opening, run: () => Promise<T>): Promise<T> {
+    return this.sync.withBookSyncLock(row.userId, row.bookId, run);
+  }
+
+  private async remoteBook(row: Opening, token: string, bookId: number): Promise<RemoteBook | undefined> {
+    const data = await this.client.query<{ me: { user_books: RemoteBook[] }[] }>(row.userId, token, QUERY, { bookId });
+    return data.me[0]?.user_books[0];
+  }
+
+  private async setStatus(row: Opening, token: string, status: number): Promise<void> {
+    const data = await this.client.query<{ update_user_book: { error: string | null } }>(
+      row.userId,
+      token,
+      'mutation OpeningStatus($id: Int!, $object: UserBookUpdateInput!) { update_user_book(id: $id, object: $object) { error } }',
+      { id: row.hardcover.userBookId, object: { status_id: status } },
+    );
+    if (data.update_user_book.error) throw new ServiceUnavailableException('Hardcover could not update the opening status');
+  }
+
+  // Called under the same lock as every normal Hardcover sync. Never adopt an existing read.
+  async start(row: Opening, today: string): Promise<void> {
+    if (row.phase !== 'active' || row.hardcover.phase === 'active') return;
+    if (row.hardcover.phase === 'creating') throw new ConflictException('Hardcover did not confirm the new reading ID; do not retry creation');
+    if (!(await this.openings.unchanged(row))) throw new ConflictException('Reading changed while opening the book');
+    const settings = await this.settings.getSettings(row.userId);
+    const state = await this.repo.findBookState(row.userId, row.bookId);
+    if (
+      !settings.effectiveEnabled ||
+      !settings.autoSyncOnStatusChange ||
+      state?.syncOverride === 'excluded' ||
+      state?.syncExcluded ||
+      (settings.bookSyncMode !== 'all_eligible' && state?.syncOverride !== 'included')
+    )
+      return;
+    const token = await this.settings.getTokenForUser(row.userId);
+    if (!token) return;
+    const book = await this.repo.findBookSyncData(row.userId, row.bookId);
+    if (!book) return;
+    const matched = await this.match.matchBook(row.userId, token, book);
+    if (!matched) return;
+
+    if (row.hardcover.phase === 'none') {
+      const before = await this.remoteBook(row, token, matched.hardcoverBookId);
+      // A book already being read elsewhere is not ours to reset. Leave Hardcover untouched.
+      if (before?.status_id === 2 || (before?.user_book_reads.length ?? 0) > 0) return;
+      // Avoid creating/removing a whole library entry just to support undo. A first-ever
+      // Hardcover addition waits for the first page turn and the normal sync path.
+      if (!before) return;
+      await this.openings.saveHardcover(row, {
+        phase: 'prepared',
+        bookId: matched.hardcoverBookId,
+        userBookId: before.id,
+        previousStatus: before.status_id,
+        previousReadId: state?.hardcoverReadId ?? null,
+      });
+    }
+    if (!(await this.openings.unchanged(row))) throw new ConflictException('Reading changed while preparing Hardcover');
+    const prepared = await this.remoteBook(row, token, row.hardcover.bookId!);
+    if (
+      matched.hardcoverBookId !== row.hardcover.bookId ||
+      !prepared ||
+      prepared.id !== row.hardcover.userBookId ||
+      prepared.user_book_reads.length ||
+      (prepared.status_id !== row.hardcover.previousStatus && prepared.status_id !== 2)
+    )
+      throw new ConflictException('Hardcover changed while preparing the opening');
+    await this.openings.saveHardcover(row, { ...row.hardcover, phase: 'creating' });
+    // Persist the intent before the non-idempotent mutation. An ambiguous response must
+    // never cause a second insert or deletion of a guessed "latest" reading.
+    const data = await this.client.query<{ insert_user_book_read: { error: string | null; user_book_read: RemoteRead | null } }>(
+      row.userId,
+      token,
+      `mutation OpeningRead($id: Int!, $object: DatesReadInput!) { insert_user_book_read(user_book_id: $id, user_book_read: $object) { error user_book_read { ${READ_FIELDS} } } }`,
+      {
+        id: row.hardcover.userBookId,
+        object: {
+          started_at: book.startedAt?.toISOString().slice(0, 10) ?? today,
+          progress_pages: 0,
+          ...(matched.hardcoverEditionId ? { edition_id: matched.hardcoverEditionId } : {}),
+        },
+      },
+    );
+    const read = data.insert_user_book_read.user_book_read;
+    if (data.insert_user_book_read.error || !read?.id || read.user_book_id !== row.hardcover.userBookId)
+      throw new ServiceUnavailableException('Hardcover did not confirm the new reading');
+    await this.openings.saveHardcover(row, { ...row.hardcover, phase: 'active', readId: read.id, expectedRead: { ...read } });
+    if (row.attemptId) await this.repo.linkReadingAttempt(row.userId, row.attemptId, read.id);
+    await this.repo.upsertBookState({
+      userId: row.userId,
+      bookId: row.bookId,
+      hardcoverUserBookId: row.hardcover.userBookId,
+      hardcoverReadId: read.id,
+    });
+    // Insert the owned read first: changing a status must not create an untracked
+    // implicit read before the explicitly identified one.
+    const current = await this.remoteBook(row, token, row.hardcover.bookId!);
+    if (
+      !current ||
+      current.id !== row.hardcover.userBookId ||
+      (current.status_id !== row.hardcover.previousStatus && current.status_id !== 2) ||
+      current.user_book_reads.length !== 1 ||
+      current.user_book_reads.some((entry) => entry.id !== read.id || !openingReadUnchanged(row.hardcover.expectedRead, entry))
+    ) {
+      throw new ConflictException('Hardcover changed before its opening status could be set');
+    }
+    if (current.status_id !== 2) await this.setStatus(row, token, 2);
+  }
+
+  async undo(row: Opening): Promise<void> {
+    if (row.hardcover.phase === 'none' || row.hardcover.phase === 'restored') return;
+    if (row.hardcover.phase === 'creating' || row.hardcover.phase === 'conflict') {
+      throw new ConflictException('Hardcover reading ownership is uncertain; its history was not changed');
+    }
+    const token = await this.settings.getTokenForUser(row.userId);
+    if (!token) throw new ServiceUnavailableException('Reconnect Hardcover to finish undoing this opening');
+    const remote = await this.remoteBook(row, token, row.hardcover.bookId!);
+    if (!remote || remote.id !== row.hardcover.userBookId) throw new ConflictException('Hardcover library entry changed');
+    if (remote.status_id !== 2 && remote.status_id !== row.hardcover.previousStatus)
+      throw new ConflictException('Hardcover status changed after opening');
+    if (remote.user_book_reads.some((read) => read.id !== row.hardcover.readId)) throw new ConflictException('Another Hardcover reading has started');
+
+    if (row.hardcover.readId && row.hardcover.phase !== 'deleted') {
+      const data = await this.client.query<{ user_book_reads: RemoteRead[] }>(row.userId, token, READ_QUERY, { id: row.hardcover.readId });
+      const current = data.user_book_reads[0];
+      if (current && !openingReadUnchanged(row.hardcover.expectedRead, current))
+        throw new ConflictException('Hardcover reading progressed after opening');
+      await this.openings.saveHardcover(row, { ...row.hardcover, phase: 'deleting' });
+      if (current) {
+        await this.client.query(row.userId, token, 'mutation UndoOpeningRead($id: Int!) { delete_user_book_read(id: $id) { __typename } }', {
+          id: row.hardcover.readId,
+        });
+        const after = await this.client.query<{ user_book_reads: RemoteRead[] }>(row.userId, token, READ_QUERY, { id: row.hardcover.readId });
+        if (after.user_book_reads.length) throw new ServiceUnavailableException('Hardcover did not confirm deletion');
+      }
+      await this.openings.saveHardcover(row, { ...row.hardcover, phase: 'deleted' });
+    }
+    // Recheck on retries, too. Only the status field is restored: ratings, reviews,
+    // edition selection and all other reading dates belong to the user.
+    const latest = await this.remoteBook(row, token, row.hardcover.bookId!);
+    if (
+      !latest ||
+      latest.id !== row.hardcover.userBookId ||
+      latest.user_book_reads.length ||
+      (latest.status_id !== 2 && latest.status_id !== row.hardcover.previousStatus)
+    ) {
+      throw new ConflictException('Hardcover changed before its status could be restored');
+    }
+    if (latest.status_id !== row.hardcover.previousStatus) await this.setStatus(row, token, row.hardcover.previousStatus!);
+    await this.repo.upsertBookState({
+      userId: row.userId,
+      bookId: row.bookId,
+      hardcoverReadId: row.hardcover.previousReadId ?? null,
+      lastSyncedStatus: null,
+      lastSyncedProgress: null,
+      lastSyncedStartedAt: null,
+      lastSyncedFinishedAt: null,
+    });
+    await this.openings.saveHardcover(row, { ...row.hardcover, phase: 'restored' });
+  }
+}
