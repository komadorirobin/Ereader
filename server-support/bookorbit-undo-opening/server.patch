@@ -0,0 +1,98 @@
+import { ConflictException, Logger, NotFoundException, ValidationPipe } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { RequestUser } from '../../common/types/request-user';
+import { HardcoverOpeningService } from '../hardcover/hardcover-opening.service';
+import { HardcoverSyncService } from '../hardcover/hardcover-sync.service';
+import { ReadingOpeningService } from '../user-book-status/reading-opening.service';
+import { KoreaderOpeningDto } from './dto/koreader-opening.dto';
+import { KoreaderOpeningService } from './koreader-opening.service';
+import { KoreaderRepository } from './koreader.repository';
+
+describe('KOReader opening contract', () => {
+  const user = { id: 1, settings: { timezone: 'Europe/Stockholm' } } as unknown as RequestUser;
+  const dto = { id: '11111111-1111-4111-8111-111111111111', document: 'a'.repeat(32), deviceId: 'ereader' };
+  const file = { id: 3, bookId: 2 };
+  let row: { id: string; userId: number; bookId: number; bookFileId: number; deviceId: string; phase: string };
+  const repo = { getAccessibleLibraryIds: vi.fn(), resolveBookFileByHash: vi.fn() };
+  const openings = { start: vi.fn(), find: vi.fn(), commit: vi.fn(), restore: vi.fn() };
+  const hardcover = { start: vi.fn(), undo: vi.fn(), withLock: vi.fn() };
+  const sync = { withBookSyncLock: vi.fn() };
+  let service: KoreaderOpeningService;
+
+  beforeEach(async () => {
+    vi.resetAllMocks();
+    vi.spyOn(Logger.prototype, 'log').mockImplementation(() => {});
+    vi.spyOn(Logger.prototype, 'warn').mockImplementation(() => {});
+    row = { id: dto.id, userId: 1, bookId: 2, bookFileId: 3, deviceId: dto.deviceId, phase: 'active' };
+    repo.getAccessibleLibraryIds.mockResolvedValue([9]);
+    repo.resolveBookFileByHash.mockResolvedValue(file);
+    openings.start.mockResolvedValue(row);
+    openings.find.mockResolvedValue(row);
+    sync.withBookSyncLock.mockImplementation((_user, _book, run) => run());
+    hardcover.withLock.mockImplementation((_opening, run) => run());
+    const module = await Test.createTestingModule({
+      providers: [
+        KoreaderOpeningService,
+        { provide: KoreaderRepository, useValue: repo },
+        { provide: ReadingOpeningService, useValue: openings },
+        { provide: HardcoverOpeningService, useValue: hardcover },
+        { provide: HardcoverSyncService, useValue: sync },
+      ],
+    }).compile();
+    service = module.get(KoreaderOpeningService);
+  });
+
+  it('resolves only files accessible to the current user and returns the Lua contract', async () => {
+    expect(await service.start(user, dto)).toEqual({ id: dto.id, phase: 'active', hardcoverPending: false });
+    expect(repo.getAccessibleLibraryIds).toHaveBeenCalledWith(1);
+    expect(repo.resolveBookFileByHash).toHaveBeenCalledWith(dto.document, [9], 1);
+    expect(openings.start).toHaveBeenCalledWith(1, 2, 3, dto.deviceId, dto.id, expect.any(String));
+  });
+
+  it('does not write inaccessible books', async () => {
+    repo.resolveBookFileByHash.mockResolvedValue(null);
+    await expect(service.start(user, dto)).rejects.toBeInstanceOf(NotFoundException);
+    expect(openings.start).not.toHaveBeenCalled();
+  });
+
+  it('does not let another device undo this opening', async () => {
+    await expect(service.finish(user, { ...dto, deviceId: 'phone' }, true)).rejects.toBeInstanceOf(NotFoundException);
+    expect(openings.find).toHaveBeenCalledWith(user.id, dto.id);
+    expect(openings.restore).not.toHaveBeenCalled();
+  });
+
+  it('checks the original file on undo, not just its book', async () => {
+    repo.resolveBookFileByHash.mockResolvedValue({ ...file, id: 99 });
+    await expect(service.finish(user, dto, true)).rejects.toBeInstanceOf(NotFoundException);
+    expect(hardcover.undo).not.toHaveBeenCalled();
+  });
+
+  it('does not touch Hardcover when local reading changed', async () => {
+    openings.restore.mockRejectedValue(new ConflictException('changed'));
+    await expect(service.finish(user, dto, true)).rejects.toBeInstanceOf(ConflictException);
+    expect(hardcover.undo).not.toHaveBeenCalled();
+  });
+
+  it('reports partial remote failure explicitly and allows retry with the same id', async () => {
+    hardcover.undo.mockRejectedValueOnce(new Error('timeout')).mockResolvedValueOnce(undefined);
+    expect(await service.finish(user, dto, true)).toEqual({ id: dto.id, phase: 'undone', hardcoverPending: true });
+    row.phase = 'undone';
+    expect(await service.finish(user, dto, true)).toEqual({ id: dto.id, phase: 'undone', hardcoverPending: false });
+    expect(openings.restore).toHaveBeenCalledTimes(2);
+  });
+
+  it('refuses a delayed commit after undo', async () => {
+    row.phase = 'undone';
+    await expect(service.finish(user, dto, false)).rejects.toBeInstanceOf(ConflictException);
+    expect(openings.commit).not.toHaveBeenCalled();
+  });
+
+  it('accepts the exact plugin payload with strict validation', async () => {
+    const pipe = new ValidationPipe({ transform: true, whitelist: true, forbidNonWhitelisted: true });
+    expect(await pipe.transform(dto, { type: 'body', metatype: KoreaderOpeningDto })).toEqual(dto);
+    await expect(pipe.transform({ ...dto, userId: 999 }, { type: 'body', metatype: KoreaderOpeningDto })).rejects.toThrow();
+    await expect(pipe.transform({ ...dto, id: 'not-uuid' }, { type: 'body', metatype: KoreaderOpeningDto })).rejects.toThrow();
+    await expect(pipe.transform({ ...dto, document: '../other' }, { type: 'body', metatype: KoreaderOpeningDto })).rejects.toThrow();
+  });
+});
