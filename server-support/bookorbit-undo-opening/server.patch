+import { Test } from '@nestjs/testing';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { ReadingOpeningService } from '../user-book-status/reading-opening.service';
+import { HardcoverBookMatchService } from './hardcover-book-match.service';
+import { HardcoverClientService } from './hardcover-client.service';
+import { HardcoverOpeningService, openingReadUnchanged } from './hardcover-opening.service';
+import { HardcoverRepository } from './hardcover.repository';
+import { HardcoverSettingsService } from './hardcover-settings.service';
+import { HardcoverSyncService } from './hardcover-sync.service';
+
+type Opening = Awaited<ReturnType<ReadingOpeningService['find']>>;
+const read = {
+  id: 901,
+  user_book_id: 55,
+  started_at: '2026-10-01',
+  finished_at: null,
+  finished_at_precision: null,
+  paused_at: null,
+  progress: 0,
+  progress_pages: 0,
+  progress_seconds: null,
+  edition_id: 20,
+};
+const remote = (reads: (typeof read)[] = [], status = 1) => ({ me: [{ user_books: [{ id: 55, status_id: status, user_book_reads: reads }] }] });
+
+describe('HardcoverOpeningService', () => {
+  let service: HardcoverOpeningService;
+  let row: Opening;
+  const openings = { unchanged: vi.fn(), saveHardcover: vi.fn() };
+  const repo = { findBookState: vi.fn(), findBookSyncData: vi.fn(), linkReadingAttempt: vi.fn(), upsertBookState: vi.fn() };
+  const client = { query: vi.fn() };
+  const settings = { getSettings: vi.fn(), getTokenForUser: vi.fn() };
+  const match = { matchBook: vi.fn() };
+  const sync = { withBookSyncLock: vi.fn((_user, _book, run) => run()) };
+
+  beforeEach(async () => {
+    vi.resetAllMocks();
+    row = {
+      id: '11111111-1111-4111-8111-111111111111',
+      userId: 1,
+      bookId: 2,
+      bookFileId: 3,
+      deviceId: 'reader',
+      phase: 'active',
+      previousStatus: null,
+      attemptId: 4,
+      fingerprint: 'abc',
+      hardcover: { phase: 'none' },
+      createdAt: new Date(),
+    };
+    openings.unchanged.mockResolvedValue(true);
+    openings.saveHardcover.mockImplementation((opening, state) => {
+      opening.hardcover = state;
+      return Promise.resolve();
+    });
+    settings.getSettings.mockResolvedValue({ effectiveEnabled: true, autoSyncOnStatusChange: true, bookSyncMode: 'all_eligible' });
+    settings.getTokenForUser.mockResolvedValue('test-token');
+    repo.findBookSyncData.mockResolvedValue({ bookId: 2, startedAt: new Date('2026-10-01') });
+    repo.findBookState.mockResolvedValue({ hardcoverReadId: 77 });
+    repo.linkReadingAttempt.mockResolvedValue('linked');
+    match.matchBook.mockResolvedValue({ hardcoverBookId: 10, hardcoverEditionId: 20 });
+    const module = await Test.createTestingModule({
+      providers: [
+        HardcoverOpeningService,
+        { provide: ReadingOpeningService, useValue: openings },
+        { provide: HardcoverRepository, useValue: repo },
+        { provide: HardcoverClientService, useValue: client },
+        { provide: HardcoverSettingsService, useValue: settings },
+        { provide: HardcoverBookMatchService, useValue: match },
+        { provide: HardcoverSyncService, useValue: sync },
+      ],
+    }).compile();
+    service = module.get(HardcoverOpeningService);
+  });
+
+  function active() {
+    row.hardcover = {
+      phase: 'active',
+      bookId: 10,
+      userBookId: 55,
+      previousStatus: 1,
+      previousReadId: 77,
+      readId: read.id,
+      expectedRead: { ...read },
+    };
+  }
+
+  it('creates and durably owns exactly one new read before setting reading status', async () => {
+    client.query
+      .mockResolvedValueOnce(remote())
+      .mockResolvedValueOnce(remote())
+      .mockImplementationOnce(() => {
+        expect(row.hardcover.phase).toBe('creating');
+        return Promise.resolve({ insert_user_book_read: { error: null, user_book_read: read } });
+      })
