+import { Test } from '@nestjs/testing';
+import { describe, expect, it, vi } from 'vitest';
+import { ReadingOpeningRepository } from './reading-opening.repository';
+import { ReadingOpeningService } from './reading-opening.service';
+
+describe('ReadingOpeningService', () => {
+  it.each([false, true])('holds normal Hardcover sync only while the exact opening remains unchanged: %s', async (unchanged) => {
+    const opening = { id: 'opening', userId: 1, bookId: 2 };
+    const repo = { active: vi.fn().mockResolvedValue(opening), unchanged: vi.fn().mockResolvedValue(unchanged), commit: vi.fn() };
+    const module = await Test.createTestingModule({
+      providers: [ReadingOpeningService, { provide: ReadingOpeningRepository, useValue: repo }],
+    }).compile();
+    expect(await module.get(ReadingOpeningService).holdsSync(1, 2)).toBe(unchanged);
+    expect(repo.active).toHaveBeenCalledWith(1, 2);
+    expect(repo.commit).toHaveBeenCalledTimes(unchanged ? 0 : 1);
+  });
+});
