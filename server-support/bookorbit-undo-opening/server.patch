+    expect(client.query.mock.calls.some((call) => call[2].includes('mutation OpeningStatus'))).toBe(false);
+  });
+
+  it.each([remote([], 2), remote([read]), { me: [{ user_books: [] }] }])(
+    'does not adopt existing remote activity or create a whole library entry',
