+import { randomUUID } from 'node:crypto';
+import { Pool } from 'pg';
+import { and, eq } from 'drizzle-orm';
+import { drizzle } from 'drizzle-orm/node-postgres';
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { ConflictException, NotFoundException } from '@nestjs/common';
+import * as schema from '../../db/schema';
+import { ReadingOpeningRepository } from './reading-opening.repository';
+
+// Opt-in integration suite, never uses the application's DATABASE_URL or deletes library data.
+const url = process.env.OPENING_TEST_DATABASE_URL;
+describe.skipIf(!url)('ReadingOpeningRepository (isolated PostgreSQL)', () => {
+  let pool: Pool;
+  let db: ReturnType<typeof drizzle<typeof schema>>;
+  let repo: ReadingOpeningRepository;
+  let userId: number, otherUserId: number, libraryId: number, folderId: number, bookId: number, fileId: number;
+  const today = '2026-10-01';
+  let id: string;
+
+  beforeAll(() => {
+    const parsed = new URL(url!);
+    if (parsed.hostname !== '127.0.0.1' || parsed.pathname !== '/bookorbit_undo_test')
+      throw new Error('Use an isolated local bookorbit_undo_test database');
+    pool = new Pool({ connectionString: url, max: 4 });
+    db = drizzle(pool, { schema });
+    repo = new ReadingOpeningRepository(db);
+  });
+  afterAll(async () => {
+    if (pool) await pool.end();
+  });
+  beforeEach(async () => {
+    id = randomUUID();
+    const users = await db
+      .insert(schema.users)
+      .values([
+        { username: `undo-${id}`, name: 'Undo test', passwordHash: 'not-a-real-account' },
+        { username: `other-${id}`, name: 'Other test', passwordHash: 'not-a-real-account' },
+      ])
+      .returning({ id: schema.users.id });
+    userId = users[0]!.id;
+    otherUserId = users[1]!.id;
+    const [library] = await db
+      .insert(schema.libraries)
+      .values({ name: `Undo test ${id}` })
+      .returning({ id: schema.libraries.id });
+    libraryId = library!.id;
+    const [folder] = await db
+      .insert(schema.libraryFolders)
+      .values({ libraryId, path: `/undo-test/${id}` })
+      .returning({ id: schema.libraryFolders.id });
+    folderId = folder!.id;
+    const [book] = await db
+      .insert(schema.books)
+      .values({ libraryId, libraryFolderId: folderId, folderPath: `/undo-test/${id}/book` })
+      .returning({ id: schema.books.id });
+    bookId = book!.id;
+    const [file] = await db
+      .insert(schema.bookFiles)
+      .values({ bookId, libraryFolderId: folderId, absolutePath: `/undo-test/${id}/book.epub`, ino: 1n, format: 'epub' })
+      .returning({ id: schema.bookFiles.id });
+    fileId = file!.id;
+  });
+  afterEach(async () => {
+    // Only these unique fixtures are removed. No truncate or database-wide reset.
+    if (libraryId) await db.delete(schema.libraries).where(eq(schema.libraries.id, libraryId));
+    if (userId) await db.delete(schema.users).where(eq(schema.users.id, userId));
+    if (otherUserId) await db.delete(schema.users).where(eq(schema.users.id, otherUserId));
+  });
+
+  const start = () => repo.start(userId, bookId, fileId, 'ereader', id, today);
+  const status = () =>
+    db.query.userBookStatus.findFirst({ where: and(eq(schema.userBookStatus.userId, userId), eq(schema.userBookStatus.bookId, bookId)) });
+
+  it('creates one reading, retries idempotently, restores unread and tombstones only its attempt', async () => {
+    const row = await start();
+    expect(await repo.unchanged(row)).toBe(true);
+    expect((await status())?.status).toBe('reading');
+    expect((await start()).attemptId).toBe(row.attemptId);
+    await repo.restore(row);
+    const undone = await repo.find(userId, id);
+    expect(undone.phase).toBe('undone');
+    expect(await status()).toMatchObject({ status: 'unread', startedAt: null, finishedAt: null });
+    const attempts = await db.query.readingAttempts.findMany({
+      where: and(eq(schema.readingAttempts.userId, userId), eq(schema.readingAttempts.bookId, bookId)),
+    });
+    expect(attempts).toHaveLength(1);
+    expect(attempts[0]!.deletedAt).toBeInstanceOf(Date);
+    await repo.restore(undone);
+    expect(await repo.unchanged(undone)).toBe(true);
+  });
+
+  it("restores want-to-read without deleting ratings or another user's reading", async () => {
+    await db.insert(schema.userBookStatus).values([
+      { userId, bookId, status: 'want_to_read', source: 'manual' },
+      { userId: otherUserId, bookId, status: 'reading', source: 'manual' },
+    ]);
+    await db.insert(schema.userBookRatings).values({ userId, bookId, rating: 4 });
+    const row = await start();
+    await repo.restore(row);
+    expect(await status()).toMatchObject({ status: 'want_to_read', source: 'manual' });
+    expect((await db.query.userBookRatings.findFirst({ where: eq(schema.userBookRatings.userId, userId) }))?.rating).toBe(4);
+    expect((await db.query.userBookStatus.findFirst({ where: eq(schema.userBookStatus.userId, otherUserId) }))?.status).toBe('reading');
+  });
+
+  it('scopes operation IDs to the user, book, file and device', async () => {
+    await start();
+    await expect(repo.find(otherUserId, id)).rejects.toBeInstanceOf(NotFoundException);
+    await expect(repo.start(otherUserId, bookId, fileId, 'ereader', id, today)).rejects.toBeInstanceOf(ConflictException);
+    await expect(repo.start(userId, bookId, fileId, 'phone', id, today)).rejects.toBeInstanceOf(ConflictException);
+  });
+
+  it('refuses a book with an existing completed reading even after its status was cleared', async () => {
+    await db
+      .insert(schema.readingAttempts)
+      .values({ userId, bookId, startedOn: '2026-09-01', endedOn: '2026-09-10', outcome: 'completed', origin: 'manual' });
+    await expect(start()).rejects.toBeInstanceOf(ConflictException);
+    expect(await status()).toBeUndefined();
+  });
+
+  it('refuses previously read device progress even when aggregate progress is absent', async () => {
+    await db.insert(schema.koreaderDeviceProgress).values({ userId, bookFileId: fileId, deviceId: 'old-reader', percentage: 0.2 });
+    await expect(start()).rejects.toBeInstanceOf(ConflictException);
+  });
+
+  it('refuses any later mobile progress, also on another format of the book', async () => {
+    const row = await start();
+    const [otherFile] = await db
+      .insert(schema.bookFiles)
+      .values({ bookId, libraryFolderId: folderId, absolutePath: `/undo-test/${id}/other.pdf`, ino: 2n, format: 'pdf' })
+      .returning({ id: schema.bookFiles.id });
+    await db.insert(schema.readingProgress).values({ userId, bookFileId: otherFile!.id, percentage: 25 });
+    expect(await repo.unchanged(row)).toBe(false);
+    await expect(repo.restore(row)).rejects.toBeInstanceOf(ConflictException);
+    expect((await status())?.status).toBe('reading');
+    expect((await repo.find(userId, id)).phase).toBe('active');
+  });
+
+  it('detects a changed reading session even if the percentage does not move', async () => {
+    const row = await start();
+    await db.insert(schema.readingSessions).values({
+      userId,
+      bookId,
+      bookFileId: fileId,
+      sessionId: randomUUID(),
+      source: 'ios',
+      startedAt: new Date(),
+      endedAt: new Date(),
+      durationSeconds: 0,
+    });
+    await expect(repo.restore(row)).rejects.toBeInstanceOf(ConflictException);
+  });
+
+  it('does not mistake Hardcover ownership stamps for reading activity', async () => {
+    const row = await start();
+    await db
+      .update(schema.readingAttempts)
+      .set({ externalProvider: 'hardcover', externalId: '901', updatedAt: new Date() })
+      .where(eq(schema.readingAttempts.id, row.attemptId!));
+    expect(await repo.unchanged(row)).toBe(true);
+    await repo.restore(row);
+  });
+
+  it('preserves a new bookmark from the mobile reader by refusing undo', async () => {
+    const row = await start();
+    await db.insert(schema.bookmarks).values({ userId, bookId, title: 'Keep this', cfi: 'epubcfi(/6/2)' });
+    await expect(repo.restore(row)).rejects.toBeInstanceOf(ConflictException);
+    expect(await db.query.bookmarks.findFirst({ where: eq(schema.bookmarks.userId, userId) })).toBeDefined();
+  });
+
+  it('does not block undo because a different user read the same book', async () => {
+    const row = await start();
+    await db.insert(schema.readingProgress).values({ userId: otherUserId, bookFileId: fileId, percentage: 95 });
+    expect(await repo.unchanged(row)).toBe(true);
+    await repo.restore(row);
+  });
+
+  it('refuses late remote cleanup if reading resumed after the local undo', async () => {
+    const row = await start();
+    await repo.restore(row);
+    await db.update(schema.userBookStatus).set({ status: 'reading', updatedAt: new Date() }).where(eq(schema.userBookStatus.userId, userId));
+    await expect(repo.restore(await repo.find(userId, id))).rejects.toBeInstanceOf(ConflictException);
+  });
+
+  it('protects committed and expired openings', async () => {
+    const row = await start();
+    await repo.commit(row);
+    await expect(repo.restore(row)).rejects.toBeInstanceOf(ConflictException);
+    await db
+      .update(schema.readingOpenings)
+      .set({ phase: 'active', createdAt: new Date(Date.now() - 86400001) })
+      .where(eq(schema.readingOpenings.id, id));
+    expect(await repo.unchanged(await repo.find(userId, id))).toBe(false);
+    await expect(repo.restore(row)).rejects.toBeInstanceOf(ConflictException);
+  });
+
+  it('concurrent duplicate starts never create two reading attempts', async () => {
+    const results = await Promise.allSettled([start(), start()]);
+    expect(results.some((result) => result.status === 'fulfilled')).toBe(true);
+    const row = await start();
+    const attempts = await db.query.readingAttempts.findMany({
+      where: and(eq(schema.readingAttempts.userId, userId), eq(schema.readingAttempts.bookId, bookId)),
+    });
+    expect(attempts).toHaveLength(1);
+    expect(attempts[0]!.id).toBe(row.attemptId);
+  });
+});
diff --git a/server/src/modules/user-book-status/reading-opening.repository.ts b/server/src/modules/user-book-status/reading-opening.repository.ts
new file mode 100644
index 0000000..67444e7
--- /dev/null
+++ b/server/src/modules/user-book-status/reading-opening.repository.ts
@@ -0,0 +1,190 @@
+import { ConflictException, Inject, Injectable, NotFoundException } from '@nestjs/common';
+import { and, desc, eq, isNull, sql } from 'drizzle-orm';
+import type { NodePgDatabase } from 'drizzle-orm/node-postgres';
+import { createHash } from 'node:crypto';
+import { DB } from '../../db';
+import * as schema from '../../db/schema';
+
+type Db = NodePgDatabase<typeof schema>;
+type Tx = Parameters<Parameters<Db['transaction']>[0]>[0];
+type Opening = typeof schema.readingOpenings.$inferSelect;
+const MAX_AGE_MS = 24 * 60 * 60 * 1000;
+
+@Injectable()
+export class ReadingOpeningRepository {
+  constructor(@Inject(DB) private readonly db: Db) {}
+
+  private async fingerprint(db: Db | Tx, userId: number, bookId: number): Promise<string> {
+    // Include every reading source, including edits that happen to retain the same percentage.
+    // Hardcover ownership stamps are not reading activity, so exclude those from attempts.
+    const result = await db.execute(sql`
+      select jsonb_build_object(
+        'status', (select to_jsonb(s) from user_book_status s where s.user_id=${userId} and s.book_id=${bookId}),
+        'progress', (select jsonb_agg(to_jsonb(p) order by p.book_file_id) from reading_progress p join book_files f on f.id=p.book_file_id where p.user_id=${userId} and f.book_id=${bookId}),
+        'devices', (select jsonb_agg(to_jsonb(p) order by p.id) from koreader_device_progress p join book_files f on f.id=p.book_file_id where p.user_id=${userId} and f.book_id=${bookId}),
+        'attempts', (select jsonb_agg(to_jsonb(a)-'external_id'-'external_provider'-'updated_at' order by a.id) from reading_attempts a where a.user_id=${userId} and a.book_id=${bookId}),
+        'audio', (select to_jsonb(p) from audiobook_progress p where p.user_id=${userId} and p.book_id=${bookId}),
+        'annotations', (select md5(coalesce(string_agg(md5(to_jsonb(a)::text), '' order by a.id), '')) from annotations a where a.user_id=${userId} and a.book_id=${bookId}),
+        'bookmarks', (select md5(coalesce(string_agg(md5(to_jsonb(b)::text), '' order by b.id), '')) from bookmarks b where b.user_id=${userId} and b.book_id=${bookId}),
+        'sessions', (select md5(coalesce(string_agg(md5(to_jsonb(s)::text), '' order by s.id), '')) from reading_sessions s where s.user_id=${userId} and s.book_id=${bookId})
+      )::text as snapshot`);
+    return createHash('sha256').update(String(result.rows[0]?.snapshot)).digest('hex');
+  }
+
+  async find(userId: number, id: string): Promise<Opening> {
+    const row = await this.db.query.readingOpenings.findFirst({
+      where: and(eq(schema.readingOpenings.id, id), eq(schema.readingOpenings.userId, userId)),
+    });
+    if (!row) throw new NotFoundException('Opening not found');
+    return row;
+  }
+
+  async active(userId: number, bookId: number): Promise<Opening | undefined> {
+    return this.db.query.readingOpenings.findFirst({
+      where: and(eq(schema.readingOpenings.userId, userId), eq(schema.readingOpenings.bookId, bookId), eq(schema.readingOpenings.phase, 'active')),
+      orderBy: desc(schema.readingOpenings.createdAt),
+    });
+  }
+
+  async unchanged(row: Opening): Promise<boolean> {
+    return Date.now() - row.createdAt.getTime() < MAX_AGE_MS && row.fingerprint === (await this.fingerprint(this.db, row.userId, row.bookId));
+  }
+
+  async start(userId: number, bookId: number, bookFileId: number, deviceId: string, id: string, today: string): Promise<Opening> {
+    return this.db.transaction(
+      async (tx) => {
+        await tx.execute(sql`select pg_advisory_xact_lock(${userId}, ${bookId})`);
+        const prior = await tx.query.readingOpenings.findFirst({ where: eq(schema.readingOpenings.id, id) });
+        if (prior) {
+          if (prior.userId !== userId || prior.bookId !== bookId || prior.bookFileId !== bookFileId || prior.deviceId !== deviceId)
+            throw new ConflictException('Opening identity changed');
+          return prior;
+        }
+        const existing = await tx.query.readingOpenings.findFirst({
+          where: and(
+            eq(schema.readingOpenings.userId, userId),
+            eq(schema.readingOpenings.bookId, bookId),
+            eq(schema.readingOpenings.phase, 'active'),
+          ),
+        });
+        if (existing) throw new ConflictException('An opening is already pending for this book');
+        const status = await tx.query.userBookStatus.findFirst({
+          where: and(eq(schema.userBookStatus.userId, userId), eq(schema.userBookStatus.bookId, bookId)),
+        });
+        const activeAttempt = await tx.query.readingAttempts.findFirst({
+          where: and(eq(schema.readingAttempts.userId, userId), eq(schema.readingAttempts.bookId, bookId), isNull(schema.readingAttempts.deletedAt)),
+        });
+        const progress = await tx
+          .select({ percentage: schema.readingProgress.percentage })
+          .from(schema.readingProgress)
+          .innerJoin(schema.bookFiles, eq(schema.bookFiles.id, schema.readingProgress.bookFileId))
+          .where(and(eq(schema.readingProgress.userId, userId), eq(schema.bookFiles.bookId, bookId)));
+        const otherActivity = await tx.execute(sql`select
+        exists(select 1 from reading_sessions s where s.user_id=${userId} and s.book_id=${bookId}) or
+        exists(select 1 from audiobook_progress p where p.user_id=${userId} and p.book_id=${bookId} and (p.percentage > 0 or p.position_seconds > 0)) or
+        exists(select 1 from koreader_device_progress p join book_files f on f.id=p.book_file_id where p.user_id=${userId} and f.book_id=${bookId} and p.percentage > 0)
+        as present`);
+        if (
+          activeAttempt ||
+          (status && !['unread', 'want_to_read'].includes(status.status)) ||
+          progress.some((p) => p.percentage > 0) ||
+          otherActivity.rows[0]?.present
+        ) {
+          throw new ConflictException('This book already has reading activity');
+        }
+        const [attempt] = await tx.insert(schema.readingAttempts).values({ userId, bookId, startedOn: today, origin: 'koreader' }).returning();
+        const now = new Date();
+        await tx
+          .insert(schema.userBookStatus)
+          .values({ userId, bookId, status: 'reading', source: 'auto', startedAt: new Date(`${today}T00:00:00Z`), updatedAt: now })
+          .onConflictDoUpdate({
+            target: [schema.userBookStatus.userId, schema.userBookStatus.bookId],
+            set: { status: 'reading', source: 'auto', startedAt: new Date(`${today}T00:00:00Z`), finishedAt: null, updatedAt: now },
+          });
+        const [row] = await tx
+          .insert(schema.readingOpenings)
+          .values({
+            id,
+            userId,
+            bookId,
+            bookFileId,
+            deviceId,
+            phase: 'active',
+            previousStatus: status ?? null,
+            attemptId: attempt!.id,
+            fingerprint: await this.fingerprint(tx, userId, bookId),
+          })
+          .returning();
+        return row!;
+      },
+      { isolationLevel: 'serializable' },
+    );
+  }
+
+  async commit(row: Opening): Promise<void> {
+    await this.db
+      .update(schema.readingOpenings)
+      .set({ phase: 'committed' })
+      .where(and(eq(schema.readingOpenings.id, row.id), eq(schema.readingOpenings.userId, row.userId), eq(schema.readingOpenings.phase, 'active')));
+  }
+
+  async restore(row: Opening): Promise<void> {
+    await this.db.transaction(
+      async (tx) => {
+        const [current] = await tx
+          .select()
+          .from(schema.readingOpenings)
+          .where(and(eq(schema.readingOpenings.id, row.id), eq(schema.readingOpenings.userId, row.userId)))
+          .for('update');
+        if (current?.phase === 'undone') {
+          if (current.fingerprint !== (await this.fingerprint(tx, row.userId, row.bookId)))
+            throw new ConflictException('Reading changed after undo; Hardcover cleanup was stopped');
+          return;
+        }
+        if (
+          !current ||
+          current.phase !== 'active' ||
+          Date.now() - current.createdAt.getTime() >= MAX_AGE_MS ||
+          current.fingerprint !== (await this.fingerprint(tx, row.userId, row.bookId))
+        ) {
+          throw new ConflictException('Reading changed after this opening; nothing was reset');
+        }
+        const before = current.previousStatus;
+        await tx
+          .update(schema.userBookStatus)
+          .set({
+            status: before?.status ?? 'unread',
+            source: before?.source ?? 'manual',
+            startedAt: before?.startedAt ? new Date(before.startedAt) : null,
+            finishedAt: before?.finishedAt ? new Date(before.finishedAt) : null,
+            updatedAt: new Date(),
+          })
+          .where(and(eq(schema.userBookStatus.userId, row.userId), eq(schema.userBookStatus.bookId, row.bookId)));
+        if (current.attemptId)
+          await tx
+            .update(schema.readingAttempts)
+            .set({ deletedAt: new Date() })
+            .where(
+              and(
+                eq(schema.readingAttempts.id, current.attemptId),
+                eq(schema.readingAttempts.userId, row.userId),
+                eq(schema.readingAttempts.bookId, row.bookId),
+              ),
+            );
+        await tx
+          .update(schema.readingOpenings)
+          .set({ phase: 'undone', fingerprint: await this.fingerprint(tx, row.userId, row.bookId) })
+          .where(and(eq(schema.readingOpenings.id, row.id), eq(schema.readingOpenings.userId, row.userId)));
+      },
+      { isolationLevel: 'serializable' },
+    );
+  }
+
+  async saveHardcover(row: Opening, hardcover: schema.OpeningHardcoverState): Promise<void> {
+    await this.db
+      .update(schema.readingOpenings)
+      .set({ hardcover })
+      .where(and(eq(schema.readingOpenings.id, row.id), eq(schema.readingOpenings.userId, row.userId)));
+    row.hardcover = hardcover;
+  }
+}
