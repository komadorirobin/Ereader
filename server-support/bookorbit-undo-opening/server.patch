+import { Injectable } from '@nestjs/common';
+import { ReadingOpeningRepository } from './reading-opening.repository';
+
+@Injectable()
+export class ReadingOpeningService {
+  constructor(private readonly repo: ReadingOpeningRepository) {}
+
+  find: ReadingOpeningRepository['find'] = (...args) => this.repo.find(...args);
+  start: ReadingOpeningRepository['start'] = (...args) => this.repo.start(...args);
+  restore: ReadingOpeningRepository['restore'] = (...args) => this.repo.restore(...args);
+  commit: ReadingOpeningRepository['commit'] = (...args) => this.repo.commit(...args);
+  unchanged: ReadingOpeningRepository['unchanged'] = (...args) => this.repo.unchanged(...args);
+  saveHardcover: ReadingOpeningRepository['saveHardcover'] = (...args) => this.repo.saveHardcover(...args);
+
+  async holdsSync(userId: number, bookId: number): Promise<boolean> {
+    const opening = await this.repo.active(userId, bookId);
+    if (!opening) return false;
+    if (await this.repo.unchanged(opening)) return true;
+    // Activity from another client commits the opening, never rolls that client back.
+    await this.repo.commit(opening);
+    return false;
+  }
+}
